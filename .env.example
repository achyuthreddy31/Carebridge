# ===========================================
# CAREBRIDGE — Environment Configuration
# ===========================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# ---- Database ----
# SQLite (default for development):
DATABASE_URL=sqlite:///./curasync.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/curasync

# ---- Authentication ----
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- AI Provider ----
# Options: gemini, openai, mock
AI_PROVIDER=mock
# Google Gemini
GEMINI_API_KEY=
# OpenAI
OPENAI_API_KEY=

# ---- OCR ----
# Options: tesseract, pypdf2, pillow
OCR_PROVIDER=pypdf2
TESSERACT_CMD=

# ---- Storage ----
# Options: local, s3
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads
# S3 (future)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# ---- Application ----
APP_NAME=Carebridge
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=10

# ---- OTP / Access Tokens ----
ACCESS_TOKEN_EXPIRY_MINUTES=15
ACCESS_TOKEN_MAX_USES=5
OTP_EXPIRY_MINUTES=5
